<?xml version="1.0" encoding="UTF-8"?>
<!--
  NetBeans: al Run/Build del EAR, forzar goals que empaquetan e instalan
  dependencias del reactor vía reactor del parent no es trivial; estas acciones
  dejan claro el flujo y usan package tras haber hecho install del parent.
-->
<actions>
    <action>
        <actionName>build</actionName>
        <packagings>
            <packaging>ear</packaging>
        </packagings>
        <goals>
            <goal>package</goal>
        </goals>
    </action>
    <action>
        <actionName>rebuild</actionName>
        <packagings>
            <packaging>ear</packaging>
        </packagings>
        <goals>
            <goal>clean</goal>
            <goal>package</goal>
        </goals>
    </action>
    <action>
        <actionName>run</actionName>
        <packagings>
            <packaging>ear</packaging>
        </packagings>
        <goals>
            <goal>package</goal>
        </goals>
        <properties>
            <netbeans.deploy>true</netbeans.deploy>
            <netbeans.deploy.clientUrlPart>/primefaces-charts-dashboard/</netbeans.deploy.clientUrlPart>
        </properties>
    </action>
</actions>
